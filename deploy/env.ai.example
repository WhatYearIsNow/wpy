# 仅为占位模板。复制到仓库外私有文件并设置 0600，不提交真实配置。
WPY_AI_MODEL_CONFIG=/path/to/exam/config.json
WPY_AI_ACCOUNT=your_account
WPY_AI_PASSWORD=your_password
WPY_APP_KEY=banana
WPY_APP_SECRET=your_valid_api_secret
WPY_AI_STATE_DIR=/var/lib/wpy-ai-agent/state
# 校园网环境若开了 HTTPS 代理，天大模型域名需直连；不改全局代理。
NO_PROXY=ai.tju.edu.cn,localhost,127.0.0.1
no_proxy=ai.tju.edu.cn,localhost,127.0.0.1
# 沿用已验证的本机 SMTP 配置；启用后动作/浏览结果通过大肥鱼发件人汇报。
# WPY_AI_SMTP_CONFIG=/etc/wpy/notify-smtp.json
# 可选：维护者互动目标文件，不能改变硬性权限或额度。
# WPY_AI_RULES_FILE=/etc/wpy/ai-rules.txt
