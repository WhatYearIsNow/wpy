# Read-only source database maintained by the existing crawler.
WPY_NOTIFY_CRAWLER_DB=
# Private SMTP JSON already used by the personal notification service.
WPY_SMTP_CONFIG=
# Board base URL; email links append ?postId=<id>.
WPY_NOTIFY_BASE_URL=
# systemd StateDirectory normally supplies /var/lib/wpy-hotlist.
WPY_HOTLIST_STATE_DIR=/var/lib/wpy-hotlist
