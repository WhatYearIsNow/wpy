[Unit]
Description=WPY Qingnianhudi Board (read-only web)
After=network.target

[Service]
Type=simple
User=wpy
WorkingDirectory=/opt/wpy-sitewide
Environment=PYTHONUNBUFFERED=1
Environment=WPY_HOST=127.0.0.1
Environment=WPY_PORT=8765
# 口令与路径写在环境文件里，不要写进 unit
EnvironmentFile=-/opt/wpy-sitewide/deploy/env.board
ExecStart=/usr/bin/python3 -m wpy serve --host 127.0.0.1 --port 8765 --no-open
Restart=on-failure
RestartSec=3
# 细粒度权限（可选，不阻塞普通部署）
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
